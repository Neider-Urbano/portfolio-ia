# --- Base de datos ---
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/portafolio

# --- LLM (el código usa el SDK de Google Gemini) ---
# Consigue una API key gratuita en https://aistudio.google.com/app/apikey
GEMINI_API_KEY=xxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-3.6-flash

# --- Servidor MCP (apps/mcp-server) ---
MCP_SERVER_URL=http://localhost:4001/mcp
MCP_API_KEY=cambia-esto-por-un-secreto-largo-y-aleatorio

# --- NextAuth (dashboard admin) ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=genera-uno-con-openssl-rand-base64-32
