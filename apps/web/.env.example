# --- Base de datos ---
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/portafolio

# --- LLM principal (Google Gemini) ---
# Consigue una API key gratuita en https://aistudio.google.com/app/apikey
GEMINI_API_KEY=xxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-3.6-flash

# --- LLM de respaldo #1 (OpenRouter) — opcional pero recomendado ---
# Si Gemini falla (cuota agotada, error del servicio, timeout), el chat
# cambia automáticamente a este modelo sin que el visitante note diferencia
# en la forma de la respuesta. Sin esta key, el sitio sigue funcionando
# igual que antes (solo Gemini). Key gratuita en https://openrouter.ai/keys.
# OPENROUTER_MODEL=openrouter/free usa el router gratuito propio de
# OpenRouter (elige entre los modelos gratis con tool-calling disponibles en
# cada momento) — evita tener que actualizar a mano cuando un modelo
# "gratis" puntual deja de estarlo, que es justo lo que pasó con el slug
# anterior que estaba acá.
OPENROUTER_API_KEY=xxxxxxxxxxxxxxxx
OPENROUTER_MODEL=openrouter/free

# --- LLM de respaldo #2 (Groq) — opcional ---
# Se usa solo si Gemini Y OpenRouter fallan los dos — tercera red de
# seguridad, infraestructura totalmente distinta a Google/OpenRouter. Key
# gratuita en https://console.groq.com/keys
GROQ_API_KEY=xxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile

# --- Servidor MCP (apps/mcp-server) ---
MCP_SERVER_URL=http://localhost:4002/mcp
MCP_API_KEY=cambia-esto-por-un-secreto-largo-y-aleatorio

# --- Contacto: email (Resend) — opcional, sin esto el form de contacto falla al enviar ---
# Key gratuita en https://resend.com/api-keys (capa gratis ~3000 emails/mes)
RESEND_API_KEY=xxxxxxxxxxxxxxxx
# Sin dominio propio verificado en Resend, dejá el remitente de prueba de abajo — igual entrega.
RESEND_FROM_EMAIL=Portafolio <onboarding@resend.dev>
# Mientras no verifiques un dominio, Resend en modo sandbox SOLO entrega al
# email con el que te registraste ahí (no necesariamente el mismo que el
# email público del perfil) — poné ese acá.
CONTACT_TO_EMAIL=tu-email-de-cuenta-resend@ejemplo.com

# --- Contacto: Telegram — opcional, solo te avisa a vos, no reemplaza el wa.me ---
# 1. En Telegram, hablale a @BotFather → /newbot → seguí los pasos → te da un token
# 2. Hablale algo a tu bot nuevo (así puede escribirte)
# 3. Hablale a @userinfobot para que te diga tu chat id numérico
TELEGRAM_BOT_TOKEN=xxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=xxxxxxxxxxxxxxxx

# --- NextAuth (dashboard admin) ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=genera-uno-con-openssl-rand-base64-32

# --- PostHog (analítica de tráfico) — opcional, sin esto el sitio funciona igual ---
# Creá una cuenta gratis en https://posthog.com, un proyecto, y copiá su
# "Project API key" (empieza con "phc_"). NEXT_PUBLIC_* porque se usa en el
# navegador del visitante, no es secreta (así es como PostHog espera que se use).
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxx
# https://us.i.posthog.com (default) o https://eu.i.posthog.com según la región que elegiste al crear el proyecto
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
