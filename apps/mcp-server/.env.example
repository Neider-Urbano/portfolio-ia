# Puerto donde corre el servidor MCP
PORT=4002

# Cadena de conexión de MongoDB (Atlas o local)
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/portafolio

# Clave secreta compartida entre apps/web y este servidor.
# apps/web debe enviarla en el header "x-mcp-api-key" en cada request.
MCP_API_KEY=cambia-esto-por-un-secreto-largo-y-aleatorio

# Cuánto tiempo (en milisegundos) se cachean en memoria los resultados de
# las tools de lectura antes de volver a consultar MongoDB. Opcional —
# 300000 (5 minutos) por defecto si no se define. Bajalo mientras estés
# probando cambios recién editados desde el admin, subilo en producción.
MCP_CACHE_TTL_MS=300000

# Key de scope PÚBLICO (la manda el chat de apps/web): con esta key el servidor
# solo registra las tools de lectura — get_full_profile y las create_* quedan
# fuera del alcance. Generá un valor random distinto de MCP_API_KEY y poné el
# MISMO valor en apps/web/.env. Si no definís esta variable, se conserva el
# comportamiento anterior de una sola key.
MCP_PUBLIC_API_KEY=otro-secreto-largo-y-aleatorio
